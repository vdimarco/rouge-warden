# Copy to voice/.env on the computer that runs Hermes. Git ignores voice/.env.

# Twilio: the account, and the number that calls you
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15550001111

# Your phone, the one paired with the Fitbit (E.164 format)
OWNER_PHONE_NUMBER=+15552223333

# The public HTTPS address of the call server, with no path. For example, from: tailscale funnel --bg 8650
CALL_PUBLIC_URL=https://your-computer.your-tailnet.ts.net
CALL_PORT=8650

# The Hermes API server: the same value as API_SERVER_KEY in ~/.hermes/.env
HERMES_API_KEY=
HERMES_API_URL=http://127.0.0.1:8642
# Every call continues this Hermes conversation. The Pixel Watch relay uses the same id.
HERMES_CONVERSATION=watch-call

# Pixel Watch relay (voice/relay.mjs, on this same port). Leave the key empty to use voice/relay-keys.json.
# Generate a key with: node voice/relay-key.mjs new pixel-watch
WATCH_RELAY_KEY=
# WATCH_RELAY_KEYS=relay-keys.json
# FOOD_LOG_PATH=food-log.jsonl
# WATCH_RELAY_RATE=30
# WATCH_RELAY_WINDOW_MS=60000
# Default agent when a turn does not name one: hermes, pi, or openai.
# WATCH_AGENT=hermes
# JSONL memory. One object per line: at, kind, day, text. See voice/adapters.md.
# MEMORY_PATH=memory/facts.jsonl
# OpenAI-compatible adapter. OPENAI_API is responses (default) or chat.
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API=responses
# Pi CLI adapter. RPC is the warm path. PI_MODE=json forces one-shot JSON mode.
# PI_BIN=pi
# PI_PROVIDER=
# PI_MODEL=
# PI_MODE=rpc
