  "findings": [
    {
      "area": "camera and HUD",
      "result": "Player stays in frame through sampled walk, sprint, turn, jump, landing and recovery. Native HUD, minimap and objective panel remain readable in inspected full-resolution gameplay frames. No gross crop/camera failure appears.",
      "limits": "Sparse frames cannot establish subtle camera jitter or continuous smoothness."
    },
    {
      "area": "locomotion/transition coverage",
      "result": "Walking and sprinting show distinct advancing limbs; side-profile turn, braking, jump and return to idle are recognizable. Native selected-state reports verify a 90-degree turn, advancing foot-pose pairs and recovered idle.",
      "limits": "Standard fast feet/hands/plunger show blur, and sampled recovery reorients the authored pose. Smooth crossfades, contact/sliding and exact timing are not accepted from sparse frames."
    },
    {
      "area": "body, garments and prop",
      "result": "Shirt, cargo trousers, cuffs, shoes and plunger remain attached and coherent through all sampled phases, with no gross exploding vertices or detached garment. Native shirt surface is broadly stable across these sampled poses.",
      "limits": "Rigid hands do not convincingly grip the prop. Strong raised/pinched shoulder lobes remain in the companion frontal airborne stills; side motion samples do not resolve that deformation limit."
    },
    {
      "area": "jump and grounding",
      "result": "Frames show takeoff, raised/bent knees, separate ground shadow, descent, recoil and coherent recovered idle. Native reports measure 183.670 cm Standard/183.576 cm Comic peaks with zero horizontal actor drift.",
      "limits": "Exact sole planting, sink/float and full-cycle contact require continuous playback and remain unaccepted."
    },
