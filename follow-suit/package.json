{
  "name": "follow-suit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A single-player card roguelike where each card must follow the one before it by suit or by rank.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "qa": "vite build && node qa/table.e2e.mjs && tsx qa/run.e2e.ts",
    "qa:url": "node qa/table.e2e.mjs && tsx qa/run.e2e.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
